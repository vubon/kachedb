# ─── Dockerfile.linux ────────────────────────────────────────────────────────
# Standalone Linux image for manual testing and deployment.
# For the structured benchmark suite use docker/Dockerfile + docker-compose.benchmark.yml instead.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Stage 1: Build ──────────────────────────────────────────────────────────
FROM rust:1.97-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . .

# Build all release binaries targeting Linux (io_uring engine auto-enabled on Linux)
RUN cargo build --release \
    -p kachedb-server \
    -p kachedb-cli \
    -p kachedb-bench \
    2>&1

# ─── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/kachedb-server /usr/local/bin/kachedb-server
COPY --from=builder /build/target/release/kachedb-cli    /usr/local/bin/kachedb-cli
COPY --from=builder /build/target/release/kachedb-bench  /usr/local/bin/kachedb-bench

# KacheDB default port
EXPOSE 6379

# Run with 4 worker threads by default.
# Use --privileged when running to enable SQPOLL (CAP_SYS_NICE required).
CMD ["kachedb-server", "-w", "4", "-p", "6379"]
